# Deals Subscription Bot — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the blanks. NEVER commit a real `.env`
# (it holds your bot token) and NEVER paste real values into this file.
#
#   cp .env.example .env
#
# Required variables are left BLANK below — the bot refuses to start without
# them. Optional variables are shown COMMENTED OUT with their default value;
# leave them commented out to use the default, or uncomment and change them.
# ---------------------------------------------------------------------------

# BOT_TOKEN — your bot's secret token from @BotFather on Telegram.
# Create the bot: open @BotFather -> /newbot -> pick a name + username.
# BotFather replies with a token like 123456789:AAE... — paste it here.
BOT_TOKEN=

# ADMIN_ID — your own Telegram user ID (a number). Only this account can
# use the admin commands (/subscribers, /broadcast — see README section j).
# Get it by messaging your bot /myid once it is running (or ask
# @userinfobot for your ID).
ADMIN_ID=

# MIN_DISCOUNT — only deals at or above this discount % go in the digest.
#MIN_DISCOUNT=50

# DIGEST_TOP_PER_STORE — max deals per store in each morning digest.
#DIGEST_TOP_PER_STORE=5

# DIGEST_HOUR_IST — hour (IST, 24-hour clock) the daily digest is sent.
#DIGEST_HOUR_IST=9

# BOT_MODE — polling or webhook. Use polling for local dev or on a server
# that runs 24/7 (Oracle Always Free, your own VPS). Use webhook on Vercel
# (serverless — polling cannot run there).
#BOT_MODE=polling

# PORT — HTTP port the bot listens on in webhook mode. Render sets PORT
# itself — do not set this on Render. Ignored in polling mode.
#PORT=3000

# WEBHOOK_URL — your bot's public base URL, webhook mode ONLY, e.g.
# https://deals-subscription-bot.onrender.com (no trailing slash, no path).
# The bot registers <WEBHOOK_URL>/telegram as its Telegram webhook.
# Leave blank / unset in polling mode.
WEBHOOK_URL=

# DATABASE_PATH — where the subscriber database (SQLite) lives for LOCAL
# dev only. Used as the `file:` fallback when TURSO_DATABASE_URL is unset.
# Ignored on Vercel (BOT_MODE=webhook requires TURSO_DATABASE_URL).
#DATABASE_PATH=./data/subscribers.db

# TURSO_DATABASE_URL — Turso database URL. REQUIRED in production / on
# Vercel (BOT_MODE=webhook); the local file does not persist on Vercel.
# Get it from the Turso dashboard, or via the Turso CLI:
#   turso db create <name>
#   turso db show <name> --url
# Leave blank for local dev (uses the DATABASE_PATH file fallback).
TURSO_DATABASE_URL=

# TURSO_AUTH_TOKEN — auth token for a remote Turso database. REQUIRED
# whenever TURSO_DATABASE_URL is a remote (libsql:// or https://) URL;
# never needed for a local `file:` URL. Create one with the Turso CLI:
#   turso db tokens create <name>
TURSO_AUTH_TOKEN=

# FEED_URLS — optional override for where the bot fetches deals from.
# Format: comma-separated store=url pairs, no spaces. Leave blank to use the
# built-in list (the 9 scanner repos' `feed` branches — see README section i).
# Example (commented out — check scanner-patches/ for the current list):
# Example value: FEED_URLS=amazon=https://raw.githubusercontent.com/stymrj/Amazon-Now-Deals/feed/deals.json,blinkit=https://raw.githubusercontent.com/stymrj/Blinkit-Deals/feed/deals.json
FEED_URLS=
